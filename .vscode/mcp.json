{
  "inputs": [
    {
      "type": "promptString",
      "id": "archive-agent-password",
      "description": "Archive Agent MCP password (LOCAL_AUTH_PASSWORD)",
      "password": true
    }
  ],
  "servers": {
    "my-remote-server": {
      "type": "sse",
      "url": "http://127.0.0.1:8008/sse",
      "headers": {
        "VERSION": "1.2",
        "Authorization": "Bearer ${input:archive-agent-password}"
      }
    }
  }
}
